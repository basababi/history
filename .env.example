# ─── Өгөгдлийн сан ───
# Локал хөгжүүлэлт: `npm run db:dev` ажиллуулаад доорхийг ашиглана
DATABASE_URL=postgres://postgres@127.0.0.1:54321/postgres
# Production (Neon, ap-northeast-1 — ADR-004):
# DATABASE_URL=postgres://user:pass@host/nomad_legacy?sslmode=require

# ─── Session token — HMAC-SHA256 (Бүлэг 6.1) ───
# Production-д ЗААВАЛ урт санамсаргүй утга болгож солино
SESSION_SECRET=dev-only-secret-change-me

# ─── Redis (Upstash, ADR-003) ───
# Байхгүй бол лиг Postgres snapshot-оос уншина (graceful degradation),
# харин AI зөвлөхийн өдрийн лимит хэрэгжихгүй тул чат хаагдана.
REDIS_URL=

# ─── Долоо хоногийн лигийн cron хамгаалалт ───
CRON_SECRET=

# ─── LLM (ADR-007) ───
# Байхгүй бол корпусын текстийг шууд буцаана — хий үзэгдэл гарахгүй
LLM_API_KEY=
LLM_API_URL=

# ─── Voice scoring (ADR-006) ───
# FastAPI + Wav2Vec2/MMS CTC forced alignment. Байхгүй бол модуль 503 буцаана.
VOICE_SERVICE_URL=

# ─── Төлбөр (Бүлэг 8.2) ───
# Байхгүй бол checkout 503 буцаана; суралцах бүх үйлдэл үнэгүй хэвээр
QPAY_CLIENT_ID=
QPAY_CLIENT_SECRET=

# ─── Мобайл апп ───
# Expo Go API хүсэлтийг Metro (8081)-гаар дамжуулж, API-ийн 3001 портыг утсанд нээх шаардлагагүй.
# Production API ашиглах бол доорх утгыг production хаягаар солино.
EXPO_PUBLIC_API_URL=http://localhost:3001

# ─── Вэб (docs/WEB.md) ───
# Сайтын хаяг — OG зураг (Messenger карт) абсолют хаяг шаардана
PUBLIC_WEB_URL=
# «Өдрийн тав #1» болох өдөр (YYYY-MM-DD). Байхгүй бол 2026-10-19
DAILY_LAUNCH_DAY=
# Апп (native) хуваалцах линкийн гарал — вэб дээр автоматаар
EXPO_PUBLIC_WEB_URL=
