{
  "name": "@nomad/db",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "migrate": "drizzle-kit generate",
    "seed": "tsx src/seed/index.ts",
    "test": "vitest run",
    "dev": "tsx src/devServer.ts",
    "studio": "drizzle-kit studio",
    "reset": "tsx src/reset.ts",
    "content": "tsx src/content/cli.ts",
    "deploy": "tsx src/migrate.ts",
    "deploy:prod": "tsx src/migrate.ts --from-railway"
  },
  "dependencies": {
    "@nomad/core": "*",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
