{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "hnd1"
  ],
  "functions": {
    "app/api/**/route.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/league/rollover",
      "schedule": "0 16 * * 0"
    },
    {
      "path": "/api/stats/rebuild",
      "schedule": "0 18 * * *"
    }
  ]
}
